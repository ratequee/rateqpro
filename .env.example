# App runtime (Vercel + local)
AUTH_SECRET="replace-with-a-long-random-secret"
APP_URL="http://localhost:3000"

# --- Local Docker Postgres (default for `npm run dev` without a cloud project) ---
# DATABASE_URL="postgresql://rateq:rateq@localhost:5433/rateq_pro?schema=public"
# DIRECT_URL=""

# --- Supabase Postgres ---
# DATABASE_URL = Transaction pooler (port 6543). DIRECT_URL = Session pooler (port 5432).
# If the database password contains @, #, or /, URL-encode it (e.g. @ → %40).
DATABASE_URL="postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"

# Supabase API (Connect panel + API Keys)
# Publishable key replaces the old anon key. Secret key replaces service_role.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SECRET_KEY="sb_secret_..."

# Optional. Improves invoice photo scanning. Photos still work without it via on-device OCR.
# GEMINI_API_KEY=""
